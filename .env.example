# --- Telegram bot (bot/index.js) — separate process, never used by the Vite app ---
# No VITE_ prefix on purpose: Vite only exposes VITE_* vars to client code,
# so these never end up in the browser bundle.
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
